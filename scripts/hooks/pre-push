#!/usr/bin/env bash
# Reads the commits about to be pushed for private data (scripts/check-history.py):
# what is pushed is published, every version of every file and every message.
#
# git gives one line per ref pushed: <local ref> <local sha> <remote ref> <remote sha>.
# A new branch (remote sha all zeros) is read whole.
cd "$(git rev-parse --show-toplevel)" || exit 1
PY=""
for candidate in python3 python py; do
  if "$candidate" -c "import sys" >/dev/null 2>&1; then PY="$candidate"; break; fi
done
[ -z "$PY" ] && { echo "pre-push: no python interpreter found"; exit 1; }
ZERO="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue            # a deletion pushes no content
  if [ "$remote_sha" = "$ZERO" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  "$PY" scripts/check-history.py "$range" || status=1
done
if [ "$status" -ne 0 ]; then
  echo
  echo "pre-push: private data in the commits above. Nothing was pushed; fix the commits first."
fi
exit $status
